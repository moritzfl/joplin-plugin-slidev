{
  "name": "joplin-plugin-slidev",
  "version": "0.3.2",
  "scripts": {
    "sync-api": "node scripts/sync-joplin-api.mjs",
    "prepare": "npm run sync-api",
    "prepack": "npm run sync-api && npm test && npm run tsc && npm run dist",
    "verify-package": "npm run dist && node scripts/verify-package.mjs",
    "dist": "node build.mts build",
    "build-and-run": "bash scripts/build-and-run.sh",
    "build-and-debug": "bash scripts/build-and-debug.sh",
    "debug-targets": "node scripts/list-debug-targets.mjs",
    "puppeteer:joplin": "node scripts/puppeteer-joplin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moritzfl/joplin-plugin-slidev"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "npm@11.16.0",
  "keywords": [
    "joplin-plugin"
  ],
  "files": [
    "publish"
  ],
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.18.0",
    "esbuild": "0.28.1",
    "generator-joplin": "^3.7.2",
    "glob": "^13.0.6",
    "markdown-it": "^14.3.0",
    "puppeteer-core": "^24.43.1",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  }
}
